{
  "name": "@promovaweb/ebookfy",
  "version": "0.2.0",
  "description": "Organize capítulos e exporte seu ebook em PDF, EPUB e MOBI.",
  "type": "module",
  "private": false,
  "license": "UNLICENSED",
  "bin": {
    "ebookfy": "bin/ebookfy.cjs"
  },
  "termfy": {
    "bin": "ebookfy",
    "title": "Ebookfy",
    "author": "Promovaweb",
    "site": "https://promovaweb.com",
    "repository": "https://github.com/promovaweb/ebookfy",
    "framework": "https://github.com/promovaweb/termfy",
    "starterKit": "0.13.2"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "manual": "bun src/main.ts build",
    "build": "bun build ./src/main.ts --target=bun --packages=external --outdir dist/bin",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/promovaweb/ebookfy.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opentui/core": "^0.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "author": "Promovaweb",
  "files": [
    "dist/bin",
    "print",
    "brand/logo",
    "README.md",
    "bin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "@oven/bun-darwin-aarch64": "1.4.4",
    "@oven/bun-darwin-x64": "1.4.4",
    "@oven/bun-linux-aarch64": "1.4.4",
    "@oven/bun-linux-x64": "1.4.4",
    "@oven/bun-linux-aarch64-musl": "1.4.4",
    "@oven/bun-linux-x64-musl": "1.4.4",
    "@oven/bun-windows-x64": "1.4.4",
    "@oven/bun-windows-aarch64": "1.4.4"
  }
}
